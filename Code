// ─── COLOR SWATCH ─────────────────────────────────────────────────────────────
const ColorSwatch = ({ color, selected, onClick, size = 40 }) => {
  const isBlank = color === null;
  return (
    <motion.button
      whileHover={{ scale: 1.1 }}
      whileTap={{ scale: 0.9 }}
      onClick={onClick}
      style={{
        width: size, height: size,
        backgroundColor: isBlank ? '#000' : color,
        border: selected ? '3px solid white' : isBlank ? '1px solid #333' : '1px solid #1a1a1a',
        cursor: 'pointer',
        boxShadow: selected && !isBlank ? `0 0 16px ${color}` : 'none',
        transition: 'all 0.22s ease',
        display: 'flex', alignItems: 'center', justifyContent: 'center',
        flexShrink: 0, position: 'relative', overflow: 'hidden',
      }}
    >
      {isBlank && (
        <svg width={size * 0.55} height={size * 0.55} viewBox="0 0 14 14" style={{ display:'block' }}>
          <line x1="1" y1="1" x2="13" y2="13" stroke="#ff0000" strokeWidth="2.5" strokeLinecap="square"/>
          <line x1="13" y1="1" x2="1" y2="13" stroke="#ff0000" strokeWidth="2.5" strokeLinecap="square"/>
        </svg>
      )}
    </motion.button>
  );
};



